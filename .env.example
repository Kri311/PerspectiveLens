# ============================================
# PerspectiveLens — Environment Variables
# Copy this file to .env and update values
# ============================================

# Database
POSTGRES_USER=perslens
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=perslens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://perslens:changeme_in_production@postgres:5432/perslens

# Redis
REDIS_URL=redis://redis:6379/0

# News API Keys (Phase 1)
NEWS_DATA_API_KEY=your_newsdata_api_key_here
CURRENTS_API_KEY=your_currents_api_key_here

# App Config
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# NLP Engine (Phase 2)
NLP_ENGINE_URL=http://nlp-engine:8001
MODEL_CACHE_DIR=/app/model_cache
